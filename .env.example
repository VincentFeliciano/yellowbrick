# Copy to .env and fill in before building for production.

# Formspree form ID (the part after /f/ in your form's endpoint URL).
# Without it, the contact form opens the visitor's email app instead.
VITE_FORMSPREE_ID=

# Domain registered with Plausible Analytics, e.g. yellowbrick.studio.
# Leave blank to disable analytics.
VITE_PLAUSIBLE_DOMAIN=
